# -----------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------
POSTGRES_DB=conduit
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# -----------------------------------------------
# Backend Configuration (Django)
# -----------------------------------------------
DB_HOST=db
PYTHONUNBUFFERED=1
SECRET_KEY=your_django_secret_key_here
DEBUG=0
ALLOWED_HOSTS=your_domain_or_ip,localhost,127.0.0.1

# Database URL used by Django
DATABASE_URL=postgres://postgres_user:your_secure_postgres_password_here@db:5432/conduit

# -----------------------------------------------
# Django Superuser Configuration
# -----------------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your_secure_superuser_password_here
